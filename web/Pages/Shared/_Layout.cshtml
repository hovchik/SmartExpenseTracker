<!DOCTYPE html>
<html lang="en" data-theme="system">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="FlowSense — AI-powered expense tracker for Android. Track spending, scan receipts, and get smart insights." />
    <title>@ViewData["Title"] - FlowSense</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/images/icon.svg" />
</head>
<body>

<!-- Navigation -->
<header class="navbar" id="navbar">
    <div class="container nav-container">
        <a href="/" class="nav-brand">
            <span class="brand-icon">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="28" height="28" rx="8" fill="url(#brandGrad)"/>
                    <path d="M8 14.5L12 18.5L20 10" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M14 7V9M14 19V21M7 14H9M19 14H21" stroke="white" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
                    <defs>
                        <linearGradient id="brandGrad" x1="0" y1="0" x2="28" y2="28" gradientUnits="userSpaceOnUse">
                            <stop stop-color="#6366F1"/>
                            <stop offset="1" stop-color="#8B5CF6"/>
                        </linearGradient>
                    </defs>
                </svg>
            </span>
            <span class="brand-name">FlowSense</span>
        </a>

        <nav class="nav-links" id="navLinks">
            <a href="/#features" class="nav-link">Features</a>
            <a href="/#guide" class="nav-link">How It Works</a>
            <a href="/#feedback" class="nav-link">Reviews</a>
            <a href="/Privacy" class="nav-link">Privacy</a>
        </nav>

        <div class="nav-actions">
            <!-- Theme Toggle -->
            <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme" title="Toggle theme">
                <span class="theme-icon theme-icon--sun">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                    </svg>
                </span>
                <span class="theme-icon theme-icon--moon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                    </svg>
                </span>
                <span class="theme-icon theme-icon--system">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
                    </svg>
                </span>
            </button>

            <a href="/#download" class="btn btn-primary btn-sm">Download</a>

            <!-- Mobile hamburger -->
            <button class="hamburger" id="hamburger" aria-label="Toggle menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</header>

<main>
    @RenderBody()
</main>

<footer class="footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand">
                <div class="nav-brand" style="margin-bottom:.75rem">
                    <span class="brand-icon">
                        <svg width="24" height="24" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect width="28" height="28" rx="8" fill="url(#footerGrad)"/>
                            <path d="M8 14.5L12 18.5L20 10" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <defs><linearGradient id="footerGrad" x1="0" y1="0" x2="28" y2="28" gradientUnits="userSpaceOnUse"><stop stop-color="#6366F1"/><stop offset="1" stop-color="#8B5CF6"/></linearGradient></defs>
                        </svg>
                    </span>
                    <span class="brand-name">FlowSense</span>
                </div>
                <p class="footer-tagline">AI-powered expense tracking that adapts to your financial life.</p>
            </div>
            <div class="footer-links">
                <h4>Product</h4>
                <a href="/#features">Features</a>
                <a href="/#guide">How It Works</a>
                <a href="/#download">Download</a>
            </div>
            <div class="footer-links">
                <h4>Legal</h4>
                <a href="/Privacy">Privacy Policy</a>
                <a href="/Privacy#terms">Terms of Use</a>
            </div>
            <div class="footer-links">
                <h4>Connect</h4>
                <a href="/#feedback">Leave a Review</a>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year FlowSense. All rights reserved.</p>
            <p>Built with ASP.NET Core &amp; lots of care.</p>
        </div>
    </div>
</footer>

<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
