@page
@model IndexModel
@{
    ViewData["Title"] = "Smart Expense Tracking";
}

<!-- ═══════════════════════════════════════════
     HERO
══════════════════════════════════════════════ -->
<section class="hero" id="home">
    <div class="hero-bg-glow"></div>
    <div class="container hero-inner">
        <div class="hero-text">
            <div class="badge badge-pill">
                <span class="badge-dot"></span>
                AI-Powered Expense Tracker
            </div>
            <h1 class="hero-title">
                Your money,<br/>
                <span class="gradient-text">intelligently tracked</span>
            </h1>
            <p class="hero-desc">
                FlowSense uses on-device AI and cloud intelligence to automatically categorize your expenses, scan receipts, and give you actionable financial insights — all from your Android phone.
            </p>
            <div class="hero-cta" id="download">
                <a href="https://play.google.com/store" class="btn btn-primary btn-lg" target="_blank" rel="noopener">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0">
                        <path d="M3 20.5v-17c0-.83.94-1.3 1.6-.8l14 8.5a1 1 0 010 1.6l-14 8.5c-.66.5-1.6.03-1.6-.8z"/>
                    </svg>
                    Get it on Google Play
                </a>
                <a href="#guide" class="btn btn-outline btn-lg">See How It Works</a>
            </div>
            <div class="hero-stats">
                <div class="hero-stat">
                    <span class="stat-num">15+</span>
                    <span class="stat-lbl">Currencies</span>
                </div>
                <div class="hero-stat-sep"></div>
                <div class="hero-stat">
                    <span class="stat-num">4</span>
                    <span class="stat-lbl">AI Engines</span>
                </div>
                <div class="hero-stat-sep"></div>
                <div class="hero-stat">
                    <span class="stat-num">100%</span>
                    <span class="stat-lbl">On-device option</span>
                </div>
            </div>
        </div>
        <div class="hero-visual">
            <div class="phone-mockup">
                <div class="phone-frame">
                    <div class="phone-screen">
                        <div class="mock-ui">
                            <div class="mock-header">
                                <div class="mock-greeting">Good morning 👋</div>
                                <div class="mock-balance">$2,847.50</div>
                                <div class="mock-label">Total this month</div>
                            </div>
                            <div class="mock-cards">
                                <div class="mock-card mock-card--income">
                                    <span>Income</span>
                                    <strong>$5,200</strong>
                                </div>
                                <div class="mock-card mock-card--expense">
                                    <span>Expenses</span>
                                    <strong>$2,352</strong>
                                </div>
                            </div>
                            <div class="mock-chart">
                                <div class="mock-bar" style="height:45%"></div>
                                <div class="mock-bar" style="height:70%"></div>
                                <div class="mock-bar" style="height:55%"></div>
                                <div class="mock-bar" style="height:85%"></div>
                                <div class="mock-bar mock-bar--active" style="height:60%"></div>
                                <div class="mock-bar" style="height:40%"></div>
                                <div class="mock-bar" style="height:75%"></div>
                            </div>
                            <div class="mock-transactions">
                                <div class="mock-tx">
                                    <div class="mock-tx-icon">🛒</div>
                                    <div class="mock-tx-info">
                                        <span>Grocery Store</span>
                                        <small>Food &amp; Drinks</small>
                                    </div>
                                    <div class="mock-tx-amt">-$47.30</div>
                                </div>
                                <div class="mock-tx">
                                    <div class="mock-tx-icon">⛽</div>
                                    <div class="mock-tx-info">
                                        <span>Gas Station</span>
                                        <small>Transport</small>
                                    </div>
                                    <div class="mock-tx-amt">-$62.00</div>
                                </div>
                                <div class="mock-tx">
                                    <div class="mock-tx-icon">☕</div>
                                    <div class="mock-tx-info">
                                        <span>Coffee Shop</span>
                                        <small>Food &amp; Drinks</small>
                                    </div>
                                    <div class="mock-tx-amt">-$8.50</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="phone-glow"></div>
            </div>
        </div>
    </div>
    <div class="hero-wave">
        <svg viewBox="0 0 1440 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
            <path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z" fill="var(--bg-page)"/>
        </svg>
    </div>
</section>

<!-- ═══════════════════════════════════════════
     FEATURES
══════════════════════════════════════════════ -->
<section class="section" id="features">
    <div class="container">
        <div class="section-header">
            <div class="badge">Core Features</div>
            <h2 class="section-title">Everything you need to master your finances</h2>
            <p class="section-sub">Powerful tools packaged in a clean, intuitive interface.</p>
        </div>

        <div class="features-grid">
            <div class="feature-card feature-card--highlight">
                <div class="feature-icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                        <path d="M11 8v6M8 11h6"/>
                    </svg>
                </div>
                <h3>Multi-Source Capture</h3>
                <p>Add expenses manually, by scanning receipts with OCR, reading banking SMS messages, monitoring payment app notifications, or using your voice.</p>
                <ul class="feature-list">
                    <li>Camera OCR receipt scanning</li>
                    <li>Banking SMS auto-detection</li>
                    <li>14+ banking app notifications</li>
                    <li>Voice input support</li>
                </ul>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z"/><path d="M12 6v6l4 2"/>
                    </svg>
                </div>
                <h3>Tri-Mode AI Engine</h3>
                <p>Choose between cloud AI (Claude, Gemini, ChatGPT, DeepSeek), Android on-device AI, or a fully offline local model — FlowSense auto-selects the best.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                    </svg>
                </div>
                <h3>Smart Reports</h3>
                <p>Daily, weekly, and monthly reports with beautiful charts. See category breakdowns, period comparisons, and top spending patterns at a glance.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/>
                    </svg>
                </div>
                <h3>Live Currency Conversion</h3>
                <p>Track expenses in 15+ currencies with live exchange rates. Supports USD, EUR, GBP, AMD, INR, JPY, and more.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                    </svg>
                </div>
                <h3>Store Map</h3>
                <p>See every transaction geo-tagged on an interactive OpenStreetMap. Visualize your spending locations in real time.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                    </svg>
                </div>
                <h3>Budget & Alerts</h3>
                <p>Set category-level budgets and receive proactive notifications before you overspend. Includes recurring transaction scheduling and split expenses.</p>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════
     HOW IT WORKS
══════════════════════════════════════════════ -->
<section class="section section--alt" id="guide">
    <div class="container">
        <div class="section-header">
            <div class="badge">How It Works</div>
            <h2 class="section-title">Up and running in minutes</h2>
            <p class="section-sub">Follow these steps to take full control of your finances.</p>
        </div>

        <div class="steps">
            <div class="step">
                <div class="step-number">01</div>
                <div class="step-content">
                    <h3>Install &amp; Set Up</h3>
                    <p>Download FlowSense from Google Play (requires Android 12+). On first launch, the AI Setup Wizard detects your device capabilities and recommends the best AI mode — cloud, on-device, or local model.</p>
                    <div class="step-tip">
                        <strong>Tip:</strong> Grant SMS and notification access to enable automatic expense detection from your banking apps.
                    </div>
                </div>
            </div>

            <div class="step">
                <div class="step-number">02</div>
                <div class="step-content">
                    <h3>Add Your First Transactions</h3>
                    <p>Tap the <strong>+</strong> button to manually add an expense or income. Or point your camera at a receipt — AI will extract amount, merchant, and date automatically.</p>
                    <div class="step-tip">
                        <strong>Voice tip:</strong> Tap the microphone icon and say "Spent $12 on lunch at Subway" — FlowSense will parse and categorize it instantly.
                    </div>
                </div>
            </div>

            <div class="step">
                <div class="step-number">03</div>
                <div class="step-content">
                    <h3>Let AI Categorize Automatically</h3>
                    <p>FlowSense's AI engine analyzes merchant names, SMS text, and notification content to automatically assign the right category (Food, Transport, Utilities, etc.). Review and correct any miscategorizations — the AI learns from your edits.</p>
                </div>
            </div>

            <div class="step">
                <div class="step-number">04</div>
                <div class="step-content">
                    <h3>Set Budgets &amp; Get Alerts</h3>
                    <p>Navigate to <strong>Settings → Budgets</strong> to define monthly limits per category. FlowSense sends a push notification when you approach or exceed your limits, and shows progress bars on the dashboard.</p>
                </div>
            </div>

            <div class="step">
                <div class="step-number">05</div>
                <div class="step-content">
                    <h3>Analyze Your Spending</h3>
                    <p>Open the <strong>Reports</strong> tab for daily, weekly, and monthly breakdowns. Tap <strong>AI Analyze</strong> to get personalized insights, spending patterns, and actionable recommendations from your AI assistant.</p>
                    <div class="step-tip">
                        <strong>Pro tip:</strong> Use the Store Map to visualize all your purchases geographically and spot habitual spending locations.
                    </div>
                </div>
            </div>

            <div class="step">
                <div class="step-number">06</div>
                <div class="step-content">
                    <h3>Export &amp; Backup Your Data</h3>
                    <p>All data is stored locally in a single JSON file. Go to <strong>Settings → Data Management</strong> to export a full backup, import from a previous backup, or clear your data. Automatic backups run before every save operation.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════
     AI MODES EXPLAINER
══════════════════════════════════════════════ -->
<section class="section" id="ai">
    <div class="container">
        <div class="section-header">
            <div class="badge">AI Intelligence</div>
            <h2 class="section-title">Three AI modes, one seamless experience</h2>
            <p class="section-sub">FlowSense picks the right AI for your device and situation.</p>
        </div>
        <div class="ai-modes">
            <div class="ai-mode">
                <div class="ai-mode-icon ai-mode-icon--cloud">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/>
                    </svg>
                </div>
                <h3>Cloud AI</h3>
                <p>Connect your own API key for the most powerful categorization and insights. Supports Claude (Anthropic), Gemini (Google), ChatGPT (OpenAI), and DeepSeek.</p>
                <div class="ai-badges">
                    <span class="chip">Claude</span>
                    <span class="chip">Gemini</span>
                    <span class="chip">ChatGPT</span>
                    <span class="chip">DeepSeek</span>
                </div>
            </div>
            <div class="ai-mode">
                <div class="ai-mode-icon ai-mode-icon--device">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>
                    </svg>
                </div>
                <h3>On-Device AI</h3>
                <p>On Pixel 8+ and other supported devices, FlowSense uses the built-in Gemini Nano model via Android's AICore — fully private, no internet required.</p>
                <div class="ai-badges">
                    <span class="chip chip--green">Private</span>
                    <span class="chip chip--green">Offline</span>
                    <span class="chip chip--green">Fast</span>
                </div>
            </div>
            <div class="ai-mode">
                <div class="ai-mode-icon ai-mode-icon--local">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/>
                    </svg>
                </div>
                <h3>Local Model</h3>
                <p>Download Gemma 2 2B or Gemma 3 1B directly to your phone via MediaPipe. Runs entirely offline — perfect for privacy-first users or areas without connectivity.</p>
                <div class="ai-badges">
                    <span class="chip chip--purple">Gemma 2 2B</span>
                    <span class="chip chip--purple">Gemma 3 1B</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════
     FEEDBACK & RATINGS
══════════════════════════════════════════════ -->
<section class="section section--alt" id="feedback">
    <div class="container">
        <div class="section-header">
            <div class="badge">Community Reviews</div>
            <h2 class="section-title">What users are saying</h2>
            @if (Model.ReviewCount > 0)
            {
                <div class="overall-rating">
                    <div class="rating-score">@Model.AverageRating.ToString("F1")</div>
                    <div class="rating-stars-display">
                        @for (int i = 1; i <= 5; i++)
                        {
                            double fill = Math.Max(0, Math.Min(1, Model.AverageRating - (i - 1)));
                            <span class="star-display @(fill >= 1 ? "full" : fill > 0 ? "half" : "empty")">★</span>
                        }
                    </div>
                    <div class="rating-count">Based on @Model.ReviewCount review@(Model.ReviewCount != 1 ? "s" : "")</div>
                </div>
            }
        </div>

        <div class="feedback-layout">
            <!-- Review Form -->
            <div class="feedback-form-card">
                <h3>@(Model.FeedbackSubmitted ? "Thank you!" : "Leave a Review")</h3>

                @if (Model.FeedbackSubmitted)
                {
                    <div class="success-msg">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        Your review has been submitted successfully!
                    </div>
                }
                else
                {
                    <form method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            <label for="Input_Name">Your Name</label>
                            <input id="Input_Name" name="Input.Name" type="text"
                                   class="form-input @(ViewData.ModelState.GetFieldValidationState("Input.Name") == Microsoft.AspNetCore.Mvc.ModelBinding.ModelValidationState.Invalid ? "is-invalid" : "")"
                                   value="@Model.Input.Name"
                                   placeholder="e.g. Alex Johnson"
                                   maxlength="80" />
                            <span asp-validation-for="Input.Name" class="field-error"></span>
                        </div>

                        <div class="form-group">
                            <label>Your Rating</label>
                            <div class="star-rating" id="starRating" role="radiogroup" aria-label="Rating">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <input type="radio" id="star@i" name="Input.Rating" value="@i"
                                           @(Model.Input.Rating == i ? "checked" : "") />
                                    <label for="star@i" title="@i star@(i > 1 ? "s" : "")">★</label>
                                }
                            </div>
                            <span asp-validation-for="Input.Rating" class="field-error"></span>
                        </div>

                        <div class="form-group">
                            <label for="Input_Comment">Your Comment</label>
                            <textarea id="Input_Comment" name="Input.Comment"
                                      class="form-input form-textarea @(ViewData.ModelState.GetFieldValidationState("Input.Comment") == Microsoft.AspNetCore.Mvc.ModelBinding.ModelValidationState.Invalid ? "is-invalid" : "")"
                                      placeholder="Share your experience with FlowSense..."
                                      maxlength="1000" rows="4">@Model.Input.Comment</textarea>
                            <span asp-validation-for="Input.Comment" class="field-error"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-block">Submit Review</button>
                    </form>
                }
            </div>

            <!-- Reviews List -->
            <div class="reviews-list">
                @if (!Model.Reviews.Any())
                {
                    <div class="empty-reviews">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.3">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                        </svg>
                        <p>Be the first to leave a review!</p>
                    </div>
                }
                else
                {
                    @foreach (var review in Model.Reviews.Take(8))
                    {
                        <div class="review-card">
                            <div class="review-header">
                                <div class="review-avatar">@review.Name.Substring(0, 1).ToUpperInvariant()</div>
                                <div class="review-meta">
                                    <div class="review-name">@review.Name</div>
                                    <div class="review-date">@review.SubmittedAt.ToString("MMM d, yyyy")</div>
                                </div>
                                <div class="review-stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="@(i <= review.Rating ? "star-on" : "star-off")">★</span>
                                    }
                                </div>
                            </div>
                            <p class="review-comment">@review.Comment</p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>

