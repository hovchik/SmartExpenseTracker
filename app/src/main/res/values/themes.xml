<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Edge-to-edge is enforced for apps targeting API 35+, so statusBarColor /
         navigationBarColor are ignored; MainActivity calls enableEdgeToEdge(). -->
    <style name="Theme.FlowSense" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <!-- System splash screen (Android 12+) shows the new launcher mark on the brand colour -->
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
