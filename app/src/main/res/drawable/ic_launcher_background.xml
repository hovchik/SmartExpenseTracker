<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- FlowSense — Adaptive Icon Background
         Rich emerald green gradient (top-left light → bottom-right dark)
         achieved via layered shapes for vector drawable compatibility. -->

    <!-- Base dark green -->
    <path
        android:fillColor="#059669"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />

    <!-- Lighter green top-left overlay for gradient feel -->
    <path
        android:fillColor="#10B981"
        android:fillAlpha="0.7"
        android:pathData="M0,0 L108,0 L0,108 Z" />

    <!-- Subtle lighter corner accent -->
    <path
        android:fillColor="#34D399"
        android:fillAlpha="0.3"
        android:pathData="M0,0 L54,0 L0,54 Z" />

</vector>
