<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ═══ FlowSense Icon ═══
         A flowing S-curve wave representing financial flow,
         with a subtle circle backdrop for depth.
    -->

    <!-- Subtle circular glow backdrop -->
    <path
        android:fillColor="#1E3A5F"
        android:pathData="M54,20 A34,34,0,1,1 54,88 A34,34,0,1,1 54,20 Z" />

    <!-- Inner circle — dark navy depth layer -->
    <path
        android:fillColor="#0F172A"
        android:pathData="M54,24 A30,30,0,1,1 54,84 A30,30,0,1,1 54,24 Z" />

    <!-- Main flowing S-curve (teal/cyan) — the "Flow" -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#06B6D4"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M30,60 C36,42 42,38 48,46 C54,54 60,50 66,38 C70,30 74,32 78,36" />

    <!-- Secondary wave layer (indigo/violet accent) — "Sense" -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#818CF8"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M30,68 C38,54 44,52 50,58 C56,64 62,60 68,50 C72,44 76,46 80,48" />

    <!-- Highlight pulse dot on the teal curve peak -->
    <path
        android:fillColor="#06B6D4"
        android:pathData="M66,38 A3.5,3.5,0,1,1 66,38.01 Z" />

    <!-- Small glow ring around pulse dot -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#06B6D4"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.4"
        android:pathData="M66,38 A6,6,0,1,1 66,38.01 Z" />

    <!-- Upward trend arrow tip (emerald green) — growth indicator -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#34D399"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M73,40 L78,34 L80,42" />

    <!-- Subtle "F" letterform hint — bottom left -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeAlpha="0.85"
        android:pathData="M38,72 L38,64 L46,64 M38,68 L44,68" />

    <!-- Subtle "S" letterform hint — bottom right -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeAlpha="0.85"
        android:pathData="M70,64 C66,63 62,65 62,68 C62,71 66,73 70,72 C74,71 74,76 70,76 C66,76 62,74 62,74" />

</vector>
