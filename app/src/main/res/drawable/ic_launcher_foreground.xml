<?xml version="1.0" encoding="utf-8"?>
<!-- FlowSense launcher foreground: an "F" drawn as two flowing ribbons (money
     flowing in and out) with a mint spark for the on-device AI "sense".
     Everything stays inside the 66dp safe-zone circle.
     Source: icon-source/ic_launcher_foreground.svg -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="55.5"
        android:pivotY="53.5"
        android:scaleX="0.84"
        android:scaleY="0.84"
        android:translateX="-1.5"
        android:translateY="0.5">

        <!-- stem -->
        <path
            android:pathData="M36,38 L36,75"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="9"
            android:strokeLineCap="round" />

        <!-- top flow ribbon -->
        <path
            android:pathData="M36,38 C46,38 50,32 60,32 C66,32 69,35 72,38"
            android:strokeWidth="9"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="36"
                    android:startY="0"
                    android:endX="78"
                    android:endY="0">
                    <item android:offset="0" android:color="#FFFFFFFF" />
                    <item android:offset="1" android:color="#FFE0E7FF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- middle flow ribbon -->
        <path
            android:pathData="M36,55 C43,55 46,50 53,50 C57,50 59,52 61,54"
            android:strokeWidth="9"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="36"
                    android:startY="0"
                    android:endX="78"
                    android:endY="0">
                    <item android:offset="0" android:color="#FFFFFFFF" />
                    <item android:offset="1" android:color="#FFE0E7FF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- AI sense spark -->
        <path android:pathData="M66,59 C66.9,65.6 68.4,67.1 75,68 C68.4,68.9 66.9,70.4 66,77 C65.1,70.4 63.6,68.9 57,68 C63.6,67.1 65.1,65.6 66,59 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="57"
                    android:startY="59"
                    android:endX="75"
                    android:endY="77">
                    <item android:offset="0" android:color="#FF6EE7B7" />
                    <item android:offset="1" android:color="#FF10B981" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
