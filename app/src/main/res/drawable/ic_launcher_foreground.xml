<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ═══ FlowSense Icon — Rising Flow ═══
         Concept: a gradient flow line rising into an upward arrow (growth /
         cash-flow uptrend) with an AI "sense" sparkle at the crest.
         Adaptive-icon safe zone: essential marks stay within 27..81.
         Path data is kept identical to icon-source/ic_launcher_foreground.svg
         so raster and vector renderings match. -->

    <!-- soft glow under the flow -->
    <path
        android:strokeColor="#22D3EE"
        android:strokeAlpha="0.16"
        android:strokeWidth="22"
        android:strokeLineCap="round"
        android:pathData="M27,79 C47,79 50,46 79,33" />

    <!-- rising flow line -->
    <path
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:pathData="M27,79 C47,79 50,46 79,33">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="27" android:startY="79"
                android:endX="81" android:endY="29">
                <item android:offset="0.0" android:color="#FF34D399" />
                <item android:offset="0.5" android:color="#FF22D3EE" />
                <item android:offset="1.0" android:color="#FF67E8F9" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- clean upward chevron arrowhead -->
    <path
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M64,31 L81,29 L79,46">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="64" android:startY="46"
                android:endX="81" android:endY="29">
                <item android:offset="0.0" android:color="#FF22D3EE" />
                <item android:offset="1.0" android:color="#FF67E8F9" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- AI sense sparkle -->
    <path
        android:fillColor="#E0F7FA"
        android:pathData="M84,20 C84,25 85,26 90,26 C85,26 84,27 84,32 C84,27 83,26 78,26 C83,26 84,25 84,20 Z" />
</vector>
